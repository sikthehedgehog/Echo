;****************************************************************************
; FMFreqTable
; Frequency table for all FM notes
;****************************************************************************

FMFreqTable:
    dw  644, 681, 722, 765
    dw  810, 858, 910, 964
    dw  1021, 1081, 1146, 1214

;****************************************************************************
; PSGShiftTable
; Semitone shifting table for PSG instruments
;****************************************************************************

PSGShiftTable:
    db   0*2                                         ; $0x
    db   1*2,  2*2,  3*2,  4*2,  6*2,  8*2,  12*2    ; $1x..$7x
    db  -1*2, -2*2, -3*2, -4*2, -6*2, -8*2, -12*2    ; $8x..$Ex

;****************************************************************************
; DummyFMInstr
; Dummy FM instrument to mute FM channels...
;
; To-do: put this in its own file? Although I'd like for this table to stay
; in this area in memory
;****************************************************************************

DummyFMInstr:
    db  $7F         ; $40..$4C
    db  $00         ; $50..$5C
    db  $1F         ; $60..$6C
    db  $1F         ; $70..$7C
    db  $FF         ; $80..$8C
    db  $00         ; $90..$9C
